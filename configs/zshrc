# MxShell - Configuración ZSH Potente
export ZSH="$HOME/.oh-my-zsh"

# Tema personalizado
ZSH_THEME="powerlevel10k/powerlevel10k"
POWERLEVEL9K_MODE="nerdfont-complete"

# Plugins potentes
plugins=(
    git
    zsh-syntax-highlighting
    zsh-autosuggestions
    zsh-completions
    sudo
    docker
    kubectl
    python
    npm
    history
    colored-man-pages
)

# Cargar Oh My ZSH
source $ZSH/oh-my-zsh.sh

# Historial infinito
HISTSIZE=1000000
SAVEHIST=1000000
setopt INC_APPEND_HISTORY
setopt SHARE_HISTORY

# Autocompletado case-insensitive
zstyle ':completion:*' matcher-list 'm:{a-z}={A-Za-z}'

# Cargar tema personalizado
source $HOME/.mxshell/theme.zsh

# Cargar aliases personalizados
source $HOME/.mxshell/aliases.zsh

# Variables de entorno útiles
export EDITOR=nano
export BROWSER=firefox

# Prompt personalizado (para cuando no carga powerlevel10k)
PROMPT='%F{red}┌─[%F{green}%n%F{blue}@%F{magenta}%m%F{red}]─[%F{yellow}%~%F{red}]
└─%F{cyan}#%f '

# Banner personalizado
cat $HOME/.mxshell/banner.txt

# Mensaje de bienvenida
echo "🔥 MxShell listo para la acción | Escribe 'mx-help' para comandos"
